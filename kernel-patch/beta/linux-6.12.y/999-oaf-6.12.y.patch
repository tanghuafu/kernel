+
+            if (app_count == 0) {
+                printk(KERN_CONT "%-16s |\n", "(empty)");
+            } else {
+                int total_app_count = app_count;
+                int printed_count = 0;
+                int should_break = 0;
+                app_count = 0;
+                for (i = 0; i < APPID_HASH_SIZE && !should_break; i++) {
