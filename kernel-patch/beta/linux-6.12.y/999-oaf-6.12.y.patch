+static void fini_fwx_timer(void)
+{
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 15, 0)
+	timer_shutdown_sync(&fwx_timer);
+#else
+	del_timer_sync(&fwx_timer);
