--- /dev/null
+++ b/drivers/net/oaf/Kconfig
@@ -0,0 +1,18 @@
+#
+# Open Application Filter (OAF) configuration
+#
+
+config OPENAPPFILTER
+	tristate "Open Application Filter support"
+	depends on NET
+	depends on NETFILTER
+	depends on NF_CONNTRACK
+	depends on NF_CONNTRACK_MARK
+	depends on NETFILTER_XTABLES
+	default n
+	help
+	  Application identification and filtering for Linux. Traffic is
+	  classified by application id and can be filtered per user/MAC.
+
+	  To compile this driver as a module, choose M here. The module
+	  will be called oaf.
